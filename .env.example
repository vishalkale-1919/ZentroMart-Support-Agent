# ==============================================================================
# VoiceOps 2026 - ZentroMart Support Agent Configuration
# ==============================================================================

# Gnani.ai Speech API Key (STT & TTS)
# Obtain from https://app.gnani.ai/voice
GNANI_API_KEY=

# LLM Provider Configuration
# Choose either 'gemini' or 'groq' (or leave empty for offline rule & semantic engine)
LLM_PROVIDER=gemini

# Google Gemini API Key
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# Groq API Key
# Obtain from https://console.groq.com/
GROQ_API_KEY=

# Model Configuration
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Gnani Voice Configuration
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
GNANI_DEFAULT_LANG=en-IN

# Dataset & System Reference Date (Mon-Sat business days, freeze date: 20 Oct 2026)
REFERENCE_DATE=2026-10-20
